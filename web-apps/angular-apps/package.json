{
  "name": "@cloud77/angular-apps",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 7700 --proxy-config ./proxy.json",
    "start-gh": "ng serve --port 7709 --project gh-page-app --proxy-config ./proxy.json",
    "start-sample": "ng serve --project sample-app --port 7702 --proxy-config ./proxy.json",
    "start-account": "ng serve --project account-app --port 7703 --proxy-config ./proxy.json",
    "start-dashboard": "ng serve --project dashboard-app --port 7708 --proxy-config ./proxy.json",
    "build": "ng build",
    "build-angular-ui": "ng build angular-ui --configuration production",
    "build-sample": "ng build sample-app --configuration production --aot --source-map=false",
    "build-sample-href": "ng build sample-app --configuration production --base-href /angular/ --aot --source-map=false",
    "build-landing": "ng build landing-app --configuration production --aot --source-map=false",
    "build-account": "ng build account-app --configuration production --aot --source-map=false",
    "build-dashboard": "ng build dashboard-app --configuration production --aot --source-map=false",
    "build-dashboard-href": "ng build dashboard-app --configuration production --base-href /dashboard/ --aot --source-map=false",
    "build-all": "yarn build-landing && yarn build-sample && yarn build-account && yarn build-dashboard",
    "build-all-href": "yarn build-landing && yarn build-sample-href && yarn build-account && yarn build-dashboard-href",
    "build-gh-page": "ng build --project gh-page-app",
    "lint": "ng lint gh-page-app",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@microsoft/signalr": "^8.0.7",
    "@ng-util/monaco-editor": "^18.0.0",
    "@phantom-chen/cloud77": "^1.0.3",
    "@popperjs/core": "^2.11.8",
    "@swimlane/ngx-charts": "^20.5.0",
    "@zxcvbn-ts/core": "^3.0.0",
    "@zxcvbn-ts/language-en": "^3.0.0",
    "angular-calendar": "^0.31.1",
    "angular-gridster2": "^22.0.0",
    "angular-password-strength-meter": "^12.0.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.6",
    "clone": "^2.1.2",
    "cytoscape": "^3.33.1",
    "guid-typescript": "^1.0.9",
    "html2canvas": "^1.4.1",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "marked": "^18.1.1",
    "md5-typescript": "^1.0.5",
    "monaco-editor": "^0.52.0",
    "ng2-charts": "^6.0.1",
    "ngx-markdown": "^22.1.1",
    "ngx-socket-io": "^4.11.1",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "sigma": "^3.0.0-beta.32",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^9.39.1",
